rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function currentUserAccessBlocked() {
      return signedIn()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && (
          userDoc().data.get('acessoBloqueado', false) == true
          || userDoc().data.get('acessoStatus', 'ATIVO') in ['BANIDO', 'BLOQUEADO', 'EXCLUIDO']
        );
    }

    function isCentralAdminDeveloper() {
      return signedIn()
        && request.auth.token.email == 'orquestracs@gmail.com'
        && !currentUserAccessBlocked();
    }

    function isAdmin() {
      return signedIn()
        && !currentUserAccessBlocked()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && (
          userDoc().data.cargo in ['ADMIN', 'admin', 'gerente', 'GERENTE', 'Gerente Geral', 'GERENTE GERAL']
          || userDoc().data.get('cargoNormalizado', '') in ['admin', 'gerente', 'gerente geral']
        );
    }

    function isBootstrapAdmin() {
      return signedIn()
        && !currentUserAccessBlocked()
        && request.auth.token.email in ['escritoriovanmarte@hotmail.com', 'escritoriovanmarte@gmail.com'];
    }

    function isBackupOperator() {
      return isAdmin()
        || isBootstrapAdmin()
        || (isApprovedUser() && hasRole(['gerente', 'GERENTE', 'Gerente Geral', 'GERENTE GERAL', 'gerente geral', 'admin', 'ADMIN']));
    }

    function isSafeSelfUserUpdate(userId) {
      return signedIn()
        && userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['nome', 'email', 'uid', 'atualizadoEm', 'online', 'ultimoAcessoEm', 'ultimaAtividadeEm', 'onlineAtualizadoEm']);
    }

    function isSafeSelfUserCreate(userId) {
      return signedIn()
        && userId == request.auth.uid
        && request.resource.data.cargo in ['PENDENTE', 'pendente'];
    }

    function isApprovedUser() {
      return signedIn()
        && !currentUserAccessBlocked()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && !(userDoc().data.get('cargo', 'PENDENTE') in ['PENDENTE', 'pendente']);
    }

    function userRole() {
      return userDoc().data.get('cargoNormalizado', null) != null
        ? userDoc().data.get('cargoNormalizado', null)
        : userDoc().data.get('cargo', 'PENDENTE');
    }

    function hasRole(roles) {
      return userRole() in roles;
    }

    function hasCustomPermissionList(listName) {
      return 'permissoes' in userDoc().data
        && listName in userDoc().data.permissoes
        && userDoc().data.permissoes[listName] is list;
    }

    // Colecoes que cada tela realmente usa (inclui dependencias: ex. o romaneio le clientes,
    // produtos e transportes e baixa pacotes do patio). Mantido em sincronia com o codigo das telas.
    function collectionMatchesSections(collection, sections) {
      return
        ((collection in ['clientes']) && 'view-clientes' in sections)
        || ((collection in ['clientes', 'clientes_subprodutos', 'vendas_subprodutos', 'fechamentos_subprodutos', 'contas_receber']) && 'view-cavaco' in sections)
        || ((collection in ['romaneios', 'clientes', 'produtos', 'transportes', 'patio_relatorios', 'contas_receber']) && 'view-romaneio-v2' in sections)
        || ((collection in ['historico', 'romaneios', 'vendas_subprodutos', 'clientes']) && 'view-historico' in sections)
        || ((collection in ['transportes']) && 'view-transportes' in sections)
        || ((collection in ['empreiteiros', 'entradas', 'fechamentos_salvos', 'frotas', 'funcionarios', 'mapa_matos']) && 'view-entrada' in sections)
        || ((collection in ['mapa_matos', 'entradas']) && 'view-mapa' in sections)
        || ((collection in ['produtos']) && 'view-produtos' in sections)
        || ((collection in ['estoque', 'estoque_movimentacoes', 'funcionarios']) && 'view-estoque' in sections)
        || ((collection in ['frotas', 'frota_abastecimentos', 'frota_manutencoes', 'frota_relatos']) && 'view-frotas' in sections)
        || ((collection in ['financeiro_lancamentos', 'financeiro_relatorios_mensais', 'contas_receber', 'clientes', 'romaneios', 'funcionarios']) && 'view-financeiro' in sections)
        || ((collection in ['funcionarios']) && 'view-rh' in sections)
        || ((collection in ['agenda']) && 'view-agenda' in sections)
        || ((collection in ['patio_relatorios', 'produtos', 'romaneios']) && 'view-dashboard' in sections)
        || ((collection in ['auditoria_logs']) && 'view-configuracoes' in sections)
        || ((collection in ['usuarios']) && 'view-configuracoes' in sections);
    }

    // Indicadores do Inicio leem as fontes de todas as areas. Liberado so para quem pode ver os
    // indicadores (sem matriz de subsecoes para o Inicio = acesso completo, igual ao sistema).
    function canReadDashboardIndicators(collection) {
      return collection in ['romaneios', 'clientes', 'entradas', 'vendas_subprodutos', 'funcionarios', 'estoque',
          'financeiro_lancamentos', 'contas_receber', 'fechamentos_subprodutos', 'financeiro_relatorios_mensais']
        && hasCustomPermissionList('allowedSections')
        && 'view-dashboard' in userDoc().data.permissoes.allowedSections
        && (
          !('allowedSubsections' in userDoc().data.permissoes)
          || !('view-dashboard' in userDoc().data.permissoes.allowedSubsections)
          || 'indicadores' in userDoc().data.permissoes.allowedSubsections['view-dashboard']
        );
    }

    function canReadByCustomPermission(collection) {
      return isApprovedUser()
        && hasCustomPermissionList('allowedSections')
        && collectionMatchesSections(collection, userDoc().data.permissoes.allowedSections);
    }

    function canWriteByCustomPermission(collection) {
      return isApprovedUser()
        && hasCustomPermissionList('writeSections')
        && collectionMatchesSections(collection, userDoc().data.permissoes.writeSections);
    }

    function canWriteFluxoPatio(collection) {
      return collection == 'patio_relatorios'
        && isApprovedUser()
        && (
          hasRole(['empilhaderista', 'EMPILHADERISTA', 'Empilhaderista', 'empilhadeirista', 'EMPILHADEIRISTA', 'Empilhadeirista'])
          || (
            'permissoes' in userDoc().data
            && 'allowedSections' in userDoc().data.permissoes
            && ('view-dashboard' in userDoc().data.permissoes.allowedSections || 'view-romaneio-v2' in userDoc().data.permissoes.allowedSections)
          )
          || (
            'permissoes' in userDoc().data
            && 'allowedSubsections' in userDoc().data.permissoes
            && 'view-dashboard' in userDoc().data.permissoes.allowedSubsections
            && 'fluxo-patio' in userDoc().data.permissoes.allowedSubsections['view-dashboard']
          )
          || (
            'permissoes' in userDoc().data
            && 'writeSections' in userDoc().data.permissoes
            && ('view-dashboard' in userDoc().data.permissoes.writeSections || 'view-romaneio-v2' in userDoc().data.permissoes.writeSections)
          )
        );
    }

    function canAccessFrotasData(collection) {
      return collection in ['frotas', 'frota_abastecimentos', 'frota_manutencoes', 'frota_relatos', 'estoque', 'estoque_movimentacoes', 'financeiro_lancamentos']
        && isApprovedUser()
        && 'permissoes' in userDoc().data
        && 'allowedSections' in userDoc().data.permissoes
        && 'view-frotas' in userDoc().data.permissoes.allowedSections;
    }

    function canDeleteByCustomPermission(collection) {
      return isApprovedUser()
        && hasCustomPermissionList('deleteSections')
        && collectionMatchesSections(collection, userDoc().data.permissoes.deleteSections);
    }

    function isOperationalCollection(collection) {
      return collection in [
        'clientes',
        'clientes_subprodutos',
        'produtos',
        'transportes',
        'empreiteiros',
        'entradas',
        'fechamentos_salvos',
        'romaneios',
        'historico',
        'vendas_subprodutos',
        'fechamentos_subprodutos',
        'patio_relatorios',
        'funcionarios',
        'agenda',
        'estoque',
        'estoque_movimentacoes',
        'frotas',
        'frota_abastecimentos',
        'frota_manutencoes',
            'frota_relatos',
        'financeiro_lancamentos',
        'financeiro_relatorios_mensais',
        'contas_receber'
      ];
    }

    function canReadCollection(collection) {
      return isAdmin() || isBootstrapAdmin()
        || canAccessFrotasData(collection)
        || canReadByCustomPermission(collection)
        || (isApprovedUser() && canReadDashboardIndicators(collection))
        || (
        isApprovedUser() && (
          hasRole(['patrao', 'PATRÃO', 'Patrao', 'PATRÃO'])
          || (hasRole(['mecanico', 'MECANICO', 'Mecânico', 'Mecanico']) && collection in [
            'frotas',
            'frota_abastecimentos',
            'frota_manutencoes',
            'frota_relatos',
            'estoque',
            'estoque_movimentacoes',
            'financeiro_lancamentos'
          ])
          || (hasRole(['muqueiro', 'MUQUEIRO', 'Muqueiro']) && collection in [
            'empreiteiros',
            'entradas',
            'fechamentos_salvos',
            'frotas',
            'funcionarios'
          ])
          || (hasRole(['empilhaderista', 'EMPILHADERISTA', 'Empilhaderista', 'empilhadeirista', 'EMPILHADEIRISTA', 'Empilhadeirista']) && collection in [
            'patio_relatorios',
            'produtos',
            'romaneios'
          ])
          || (hasRole(['estoquista', 'ESTOQUISTA', 'Estoquista']) && collection in [
            'estoque',
            'estoque_movimentacoes',
            'funcionarios',
            'frotas',
            'frota_abastecimentos',
            'frota_manutencoes'
          ])
          || (hasRole(['gerente', 'GERENTE', 'Gerente Geral', 'GERENTE GERAL', 'gerente geral', 'admin', 'ADMIN']) && collection in [
            'clientes',
            'clientes_subprodutos',
            'produtos',
            'transportes',
            'empreiteiros',
            'entradas',
            'fechamentos_salvos',
            'romaneios',
            'historico',
            'vendas_subprodutos',
            'fechamentos_subprodutos',
            'patio_relatorios',
            'funcionarios',
            'agenda',
            'estoque',
            'estoque_movimentacoes',
            'frotas',
            'frota_abastecimentos',
            'frota_manutencoes',
            'frota_relatos',
            'financeiro_lancamentos',
            'financeiro_relatorios_mensais',
            'contas_receber'
          ])
        )
      );
    }

    function canWriteCollection(collection) {
      return isAdmin() || isBootstrapAdmin()
        || canWriteFluxoPatio(collection)
        || canAccessFrotasData(collection)
        || canWriteByCustomPermission(collection)
        || (
        isApprovedUser() && (
          (hasRole(['mecanico', 'MECANICO', 'Mecânico', 'Mecanico']) && collection in [
            'frotas',
            'frota_abastecimentos',
            'frota_manutencoes',
            'frota_relatos',
            'estoque',
            'estoque_movimentacoes',
            'financeiro_lancamentos'
          ])
          || (hasRole(['muqueiro', 'MUQUEIRO', 'Muqueiro']) && collection in [
            'empreiteiros',
            'entradas',
            'fechamentos_salvos'
          ])
          || (hasRole(['estoquista', 'ESTOQUISTA', 'Estoquista']) && collection in [
            'estoque',
            'estoque_movimentacoes'
          ])
          || (hasRole(['gerente', 'GERENTE', 'Gerente Geral', 'GERENTE GERAL', 'gerente geral', 'admin', 'ADMIN']) && collection in [
            'clientes',
            'clientes_subprodutos',
            'produtos',
            'transportes',
            'empreiteiros',
            'entradas',
            'fechamentos_salvos',
            'romaneios',
            'historico',
            'vendas_subprodutos',
            'fechamentos_subprodutos',
            'patio_relatorios',
            'funcionarios',
            'agenda',
            'estoque',
            'estoque_movimentacoes',
            'frotas',
            'frota_abastecimentos',
            'frota_manutencoes',
            'frota_relatos',
            'financeiro_lancamentos',
            'financeiro_relatorios_mensais',
            'contas_receber'
          ])
        )
      );
    }

    function canDeleteCollection(collection) {
      return isAdmin() || isBootstrapAdmin()
        || canDeleteByCustomPermission(collection)
        || (
        isApprovedUser() && (
          (hasRole(['gerente', 'GERENTE', 'Gerente Geral', 'GERENTE GERAL', 'gerente geral', 'admin', 'ADMIN']) && collection in [
            'clientes',
            'clientes_subprodutos',
            'produtos',
            'transportes',
            'empreiteiros',
            'entradas',
            'fechamentos_salvos',
            'romaneios',
            'historico',
            'vendas_subprodutos',
            'patio_relatorios',
            'funcionarios',
            'agenda',
            'estoque',
            'estoque_movimentacoes',
            'frotas',
            'frota_abastecimentos',
            'frota_manutencoes',
            'frota_relatos',
            'financeiro_lancamentos',
            'financeiro_relatorios_mensais',
            'contas_receber'
          ])
        )
      );
    }

    function sameEmpresaOnRead() {
      return !('empresaId' in resource.data)
        || !('empresaId' in userDoc().data)
        || resource.data.empresaId == userDoc().data.empresaId;
    }

    function sameEmpresaOnWrite() {
      return !('empresaId' in request.resource.data)
        || !('empresaId' in userDoc().data)
        || request.resource.data.empresaId == userDoc().data.empresaId;
    }

    match /usuarios/{userId} {
      allow create: if isAdmin() || isBootstrapAdmin() || isSafeSelfUserCreate(userId);
      allow read: if signedIn() && (userId == request.auth.uid || isAdmin() || isBootstrapAdmin() || isCentralAdminDeveloper());
      allow list: if isAdmin() || isBootstrapAdmin() || isCentralAdminDeveloper();
      allow update: if ((isAdmin() || isBootstrapAdmin()) && resource.data.email != 'orquestracs@gmail.com') || isSafeSelfUserUpdate(userId);
      allow delete: if (isAdmin() || isBootstrapAdmin()) && resource.data.email != 'orquestracs@gmail.com';

      match /seguranca/{document} {
        allow read, write: if signedIn() && userId == request.auth.uid;
      }
    }

    match /backup_snapshots/{document} {
      allow read, delete: if isBackupOperator() && sameEmpresaOnRead();
      allow create, update: if isBackupOperator() && sameEmpresaOnWrite();
    }

    match /backup_snapshot_itens/{document} {
      allow read, delete: if isBackupOperator() && sameEmpresaOnRead();
      allow create, update: if isBackupOperator() && sameEmpresaOnWrite();
    }

    match /auditoria_logs/{document} {
      allow read: if (isBackupOperator() || isCentralAdminDeveloper()) && sameEmpresaOnRead();
      allow create: if isApprovedUser() && sameEmpresaOnWrite();
      allow update, delete: if false;
    }

    // Regras de pagamento de descarga e feriados (Configuracoes > Regras de pagamento e feriados).
    // Todos os usuarios aprovados leem (calendario, conferencia e RH usam); so gerente/admin ou quem
    // tem a subsecao "regras-pagamento" grava.
    function canEditRegrasPagamento() {
      return isAdmin() || isBootstrapAdmin()
        || (isApprovedUser() && hasRole(['gerente', 'GERENTE', 'Gerente Geral', 'GERENTE GERAL', 'gerente geral', 'admin', 'ADMIN']))
        || (
          isApprovedUser()
          && 'permissoes' in userDoc().data
          && 'allowedSubsections' in userDoc().data.permissoes
          && 'view-configuracoes' in userDoc().data.permissoes.allowedSubsections
          && 'regras-pagamento' in userDoc().data.permissoes.allowedSubsections['view-configuracoes']
        );
    }

    match /configuracoes_sistema/{document} {
      allow read: if isApprovedUser() || isAdmin() || isBootstrapAdmin();
      allow create, update: if canEditRegrasPagamento();
      allow delete: if isAdmin() || isBootstrapAdmin();
    }

    // Configuracao do tanque de diesel: mesmo acesso de gravacao do estoque.
    match /estoque_config/{document} {
      allow read: if isApprovedUser() || isAdmin() || isBootstrapAdmin();
      allow create, update: if canWriteCollection('estoque');
      allow delete: if isAdmin() || isBootstrapAdmin();
    }

    match /mapa_matos/{document} {
      allow read: if (isAdmin() || isBootstrapAdmin() || canReadByCustomPermission('mapa_matos'))
        && sameEmpresaOnRead();
      allow create, update: if (isAdmin() || isBootstrapAdmin() || canWriteByCustomPermission('mapa_matos'))
        && sameEmpresaOnWrite();
      allow delete: if (isAdmin() || isBootstrapAdmin() || canDeleteByCustomPermission('mapa_matos'))
        && sameEmpresaOnRead();
    }

    // Perfil mínimo e seguro para a lista do chat. Dados pessoais continuam em usuarios.
    match /chat_perfis/{userId} {
      allow read: if isApprovedUser() && sameEmpresaOnRead();
      allow create, update: if isApprovedUser()
        && sameEmpresaOnWrite()
        && (
          (
            userId == request.auth.uid
            && request.resource.data.nome == userDoc().data.nome
            && request.resource.data.cargo == userDoc().data.cargo
          )
          ||
          (
            (isAdmin() || isBootstrapAdmin())
            && exists(/databases/$(database)/documents/usuarios/$(userId))
            && request.resource.data.nome == get(/databases/$(database)/documents/usuarios/$(userId)).data.nome
            && request.resource.data.cargo == get(/databases/$(database)/documents/usuarios/$(userId)).data.cargo
            && request.resource.data.empresaId == get(/databases/$(database)/documents/usuarios/$(userId)).data.empresaId
          )
        )
        && request.resource.data.keys().hasOnly(['nome', 'cargo', 'empresaId', 'atualizadoEm']);
      allow delete: if isAdmin() || isBootstrapAdmin() || (isApprovedUser() && userId == request.auth.uid);
    }

    // Conversas individuais: apenas remetente e destinatário podem ler as mensagens.
    match /chat_mensagens/{messageId} {
      allow read: if isApprovedUser()
        && request.auth.uid in resource.data.participantes;
      allow create: if isApprovedUser()
        && request.auth.uid == request.resource.data.remetenteId
        && request.auth.uid in request.resource.data.participantes
        && request.resource.data.destinatarioId in request.resource.data.participantes
        && request.resource.data.participantes.size() == 2
        && exists(/databases/$(database)/documents/chat_perfis/$(request.resource.data.destinatarioId))
        && get(/databases/$(database)/documents/chat_perfis/$(request.resource.data.destinatarioId)).data.empresaId == userDoc().data.empresaId
        && request.resource.data.texto is string
        && request.resource.data.texto.size() > 0
        && request.resource.data.texto.size() <= 1500
        && request.resource.data.keys().hasOnly(['texto', 'remetenteId', 'destinatarioId', 'participantes', 'empresaId', 'criadoEm'])
        && sameEmpresaOnWrite();
      allow update, delete: if false;
    }

    match /{collection}/{document} {
      allow read: if canReadCollection(collection)
        && (sameEmpresaOnRead() || collection == 'patio_relatorios' || (isApprovedUser() && isOperationalCollection(collection)))
        && collection in [
          'clientes',
          'clientes_subprodutos',
          'produtos',
          'transportes',
          'empreiteiros',
          'entradas',
          'fechamentos_salvos',
          'romaneios',
          'historico',
          'vendas_subprodutos',
          'fechamentos_subprodutos',
          'patio_relatorios',
          'funcionarios',
          'agenda',
          'estoque',
          'estoque_movimentacoes',
          'frotas',
          'frota_abastecimentos',
          'frota_manutencoes',
            'frota_relatos',
          'financeiro_lancamentos',
          'financeiro_relatorios_mensais',
          'contas_receber'
        ];

      allow create, update: if canWriteCollection(collection)
        && (sameEmpresaOnWrite() || collection == 'patio_relatorios' || (isApprovedUser() && isOperationalCollection(collection)))
        && collection in [
          'clientes',
          'clientes_subprodutos',
          'produtos',
          'transportes',
          'empreiteiros',
          'entradas',
          'fechamentos_salvos',
          'romaneios',
          'historico',
          'vendas_subprodutos',
          'fechamentos_subprodutos',
          'patio_relatorios',
          'funcionarios',
          'agenda',
          'estoque',
          'estoque_movimentacoes',
          'frotas',
          'frota_abastecimentos',
          'frota_manutencoes',
            'frota_relatos',
          'financeiro_lancamentos',
          'financeiro_relatorios_mensais',
          'contas_receber'
        ];

      allow delete: if canDeleteCollection(collection)
        && sameEmpresaOnRead()
        && collection in [
          'clientes',
          'clientes_subprodutos',
          'produtos',
          'transportes',
          'empreiteiros',
          'entradas',
          'fechamentos_salvos',
          'romaneios',
          'historico',
          'vendas_subprodutos',
          'fechamentos_subprodutos',
          'patio_relatorios',
          'funcionarios',
          'agenda',
          'estoque',
          'estoque_movimentacoes',
          'frotas',
          'frota_abastecimentos',
          'frota_manutencoes',
            'frota_relatos',
          'financeiro_lancamentos',
          'financeiro_relatorios_mensais',
          'contas_receber'
        ];
    }
  }
}
